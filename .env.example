# 数据库：生产用 PostgreSQL，本地可直接用 SQLite
AUTOEMAIL_DB_URL=sqlite:///./autoemail.db

# 业务硬规则
AUTOEMAIL_APPROVAL_LINE_USD=1000
AUTOEMAIL_ANOMALY_RATIO=1.3

# 邮件通道（IMAP/SMTP）
# QQ 邮箱示例：密码处填“授权码”，不是 QQ 登录密码
# AUTOEMAIL_IMAP_HOST=imap.qq.com
# AUTOEMAIL_IMAP_USER=your_qq_number@qq.com
# AUTOEMAIL_SMTP_HOST=smtp.qq.com
# AUTOEMAIL_SMTP_PORT=587
AUTOEMAIL_IMAP_HOST=
AUTOEMAIL_IMAP_USER=
AUTOEMAIL_IMAP_PASSWORD=
AUTOEMAIL_SMTP_HOST=
AUTOEMAIL_SMTP_PORT=587
AUTOEMAIL_SMTP_USER=
AUTOEMAIL_SMTP_PASSWORD=
AUTOEMAIL_FROM_ADDR=

# 企业微信群机器人
AUTOEMAIL_WECOM_WEBHOOK=

# LLM / RAG（默认关闭）
AUTOEMAIL_LLM_ENABLED=false
AUTOEMAIL_LLM_BASE_URL=
AUTOEMAIL_LLM_API_KEY=
AUTOEMAIL_LLM_MODEL=
AUTOEMAIL_LLM_TIMEOUT_SECONDS=20
AUTOEMAIL_LLM_MAX_OUTPUT_TOKENS=1200
AUTOEMAIL_LLM_MAX_INPUT_CHARS=30000
AUTOEMAIL_LLM_INTENT_FALLBACK_ENABLED=false
AUTOEMAIL_LLM_DRAFT_ENABLED=false
AUTOEMAIL_LLM_AUTO_SEND_ALLOWED=false
AUTOEMAIL_LLM_SHADOW_MODE=false
AUTOEMAIL_RAG_ENABLED=false
AUTOEMAIL_RAG_TOP_K=5
AUTOEMAIL_RAG_MAX_CHARS=8000
